generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique
  email          String?  @unique
  nickname       String?
  treeName       String?
  passwordHash   String
  spiritType     String   @default("snail")
  spiritLevel    Int      @default(1)
  spiritExp      Int      @default(0)
  streakDays     Int      @default(0)
  lastLoginDate  String?
  welcomeMessage String   @default("欢迎回家，今天也把心事轻轻放进树洞吧。")
  createdAt      DateTime @default(now())

  notes       Note[]
  albumImages AlbumImage[]
  replies     Reply[]
  feedLogs    FeedLog[]
  loginLogs   LoginLog[]
  pickups     BottlePickup[]
  todos       Todo[]
  petLogs     PetLog[]
}

model Todo {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  remindAt    DateTime
  isCompleted Boolean  @default(false)
  isNotified  Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Note {
  id          Int       @id @default(autoincrement())
  userId      Int
  title       String
  content     String
  contentType String    @default("text")
  category    String    @default("mood")
  status      String    @default("private")
  allowReply  Boolean   @default(true)
  isSensitive Boolean   @default(false)
  thrownAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User           @relation(fields: [userId], references: [id])
  images  NoteImage[]
  replies Reply[]
  pickups BottlePickup[]
}

model NoteImage {
  id       Int    @id @default(autoincrement())
  noteId   Int
  imageUrl String

  note Note @relation(fields: [noteId], references: [id])
}

model AlbumImage {
  id        Int      @id @default(autoincrement())
  userId    Int
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Reply {
  id         Int      @id @default(autoincrement())
  noteId     Int
  fromUserId Int
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  note     Note @relation(fields: [noteId], references: [id])
  fromUser User @relation(fields: [fromUserId], references: [id])
}

model BottlePickup {
  id             Int      @id @default(autoincrement())
  noteId         Int
  receiverUserId Int
  createdAt      DateTime @default(now())

  note     Note @relation(fields: [noteId], references: [id])
  receiver User @relation(fields: [receiverUserId], references: [id])
}

model FeedLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model LoginLog {
  id        Int    @id @default(autoincrement())
  userId    Int
  loginDate String

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, loginDate])
}

model PetLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
